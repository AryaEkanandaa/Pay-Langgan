  }
</style></head><body class="email-page" style="background-color:#f0f3fb;margin:0;padding:0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Invoice INV-20261015-001 sebesar Rp 100.000 siap dibayar.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="margin:0;padding:24px 10px;background-color:#f0f3fb;font-family:Arial, Helvetica, sans-serif"><table align="center" width="100%" class="email-card" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:640px;width:100%;margin:0 auto;background-color:#ffffff"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" class="email-padding" style="padding:36px 40px 32px"><tbody><tr><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border-bottom:4px solid #3B4EFF;padding-bottom:22px;margin-bottom:24px"><tbody><tr><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column" style="width:52%;vertical-align:top"><p class="email-ink" style="font-size:18px;line-height:24px;margin:0;color:#16213a;font-weight:700;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Kelana Workspace</p></td><td class="email-header-right" data-id="__react-email-column" style="width:48%;text-align:right;vertical-align:top"><p style="font-size:21px;line-height:26px;margin:0;color:#3B4EFF;font-weight:700;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">INVOICE</p><p class="email-ink" style="font-size:11px;line-height:24px;margin:5px 0 0;color:#16213a;font-weight:700;overflow-wrap:anywhere;margin-top:5px;margin-right:0;margin-bottom:0;margin-left:0">INV-20261015-001</p><p style="font-size:11px;line-height:24px;display:inline-block;margin:7px 0 0;padding:4px 10px;border-radius:12px;background-color:#fff3cf;color:#805500;font-weight:700;margin-top:7px;margin-right:0;margin-bottom:0;margin-left:0">Belum dibayar</p></td></tr></tbody></table></td></tr></tbody></table><p class="email-ink" style="font-size:14px;line-height:24px;margin:0 0 14px;color:#16213a;margin-top:0;margin-right:0;margin-bottom:14px;margin-left:0">Halo Arya Ekananda,</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="background-color:#edf2ff;border-left:4px solid #3B4EFF;padding:14px 16px;margin-bottom:24px"><tbody><tr><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column" style="vertical-align:top"><p style="font-size:15px;line-height:21px;margin:0;color:#2545b2;font-weight:700;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Invoice baru diterbitkan</p><p style="font-size:13px;line-height:20px;margin:5px 0 0;color:#26364f;margin-top:5px;margin-right:0;margin-bottom:0;margin-left:0">Invoice INV-20261015-001 sudah tersedia. Periksa rincian dan selesaikan pembayaran sebelum jatuh tempo.</p></td></tr></tbody></table></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-bottom:26px"><tbody><tr><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody style="width:100%"><tr style="width:100%"><td class="email-info-column" data-id="__react-email-column" style="width:50%;vertical-align:top;padding-right:12px"><p class="email-muted" style="font-size:12px;line-height:24px;margin:0 0 5px;color:#50617f;margin-top:0;margin-right:0;margin-bottom:5px;margin-left:0">Ditagihkan kepada</p><p class="email-ink" style="font-size:16px;line-height:24px;margin:0;color:#16213a;font-weight:700;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Arya Ekananda</p><p class="email-muted" style="font-size:12px;line-height:24px;margin:3px 0 0;color:#50617f;overflow-wrap:anywhere;margin-top:3px;margin-right:0;margin-bottom:0;margin-left:0">arya@example.com</p></td><td class="email-info-column" data-id="__react-email-column" style="width:50%;text-align:right;vertical-align:top"><p class="email-muted" style="font-size:12px;line-height:18px;margin:0 0 5px;color:#50617f;margin-top:0;margin-right:0;margin-bottom:5px;margin-left:0">Terbit<!-- -->: <span class="email-ink" style="color:#16213a">15 Okt 2026</span></p><p class="email-muted" style="font-size:12px;line-height:18px;margin:0 0 5px;color:#50617f;margin-top:0;margin-right:0;margin-bottom:5px;margin-left:0">Jatuh tempo<!-- -->: <span class="email-ink" style="color:#16213a">22 Okt 2026</span></p></td></tr></tbody></table></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody><tr><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" class="email-table-head" style="background-color:#eef3f9"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column" style="width:42%;padding:10px 8px"><p class="email-ink" style="font-size:10px;line-height:18px;margin:0;color:#16213a;font-weight:700;text-transform:uppercase;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Rincian</p></td><td data-id="__react-email-column" style="width:12%;padding:10px 4px;text-align:center"><p class="email-ink" style="font-size:10px;line-height:18px;margin:0;color:#16213a;font-weight:700;text-transform:uppercase;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Jumlah</p></td><td class="email-unit-price" data-id="__react-email-column" style="width:22%;padding:10px 4px;text-align:right"><p class="email-ink" style="font-size:10px;line-height:18px;margin:0;color:#16213a;font-weight:700;text-transform:uppercase;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Harga satuan</p></td><td data-id="__react-email-column" style="width:24%;padding:10px 8px;text-align:right"><p class="email-ink" style="font-size:10px;line-height:18px;margin:0;color:#16213a;font-weight:700;text-transform:uppercase;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Subtotal</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border-bottom:1px solid #dbe3ef"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column" style="width:42%;padding:12px 8px;vertical-align:top"><p class="email-ink" style="font-size:12px;line-height:18px;margin:0;color:#16213a;overflow-wrap:anywhere;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Profesional Bulanan</p></td><td data-id="__react-email-column" style="width:12%;padding:12px 4px;text-align:center;vertical-align:top"><p class="email-ink" style="font-size:12px;line-height:18px;margin:0;color:#16213a;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">1</p></td><td class="email-unit-price" data-id="__react-email-column" style="width:22%;padding:12px 4px;text-align:right;vertical-align:top"><p class="email-ink" style="font-size:12px;line-height:18px;margin:0;color:#16213a;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Rp 100.000</p></td><td data-id="__react-email-column" style="width:24%;padding:12px 8px;text-align:right;vertical-align:top"><p class="email-ink" style="font-size:12px;line-height:18px;margin:0;color:#16213a;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Rp 100.000</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border-top:1px solid #dbe3ef;margin-top:4px"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column" style="width:50%;padding-top:18px"><p class="email-ink" style="font-size:15px;line-height:24px;margin:0;color:#16213a;font-weight:700;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Total</p></td><td data-id="__react-email-column" style="width:50%;padding-top:18px;text-align:right"><p style="font-size:21px;line-height:26px;margin:0;color:#3B4EFF;font-weight:700;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Rp 100.000</p></td></tr></tbody></table></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" class="email-notice" style="margin-top:22px;padding:12px 14px;background-color:#eef3f9;border-left:3px solid #dbe3ef"><tbody><tr><td><p class="email-ink" style="font-size:12px;line-height:24px;margin:0 0 4px;color:#16213a;font-weight:700;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">Petunjuk pembayaran</p><p class="email-muted" style="font-size:12px;line-height:19px;margin:0;color:#50617f;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Buka halaman invoice untuk memilih dan menyelesaikan metode pembayaran yang tersedia.</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:26px"><tbody><tr><td><a class="email-cta" href="https://paylanggan.example/invoice/preview" style="line-height:18px;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;padding:13px 20px;border-radius:9px;background-color:#3B4EFF;color:#ffffff;font-size:13px;font-weight:700;padding-top:13px;padding-right:20px;padding-bottom:13px;padding-left:20px" target="_blank"><span><!--[if mso]><i style="mso-font-width:500%;mso-text-raise:19.5" hidden>&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9.75px">Bayar sekarang</span><span><!--[if mso]><i style="mso-font-width:500%" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border-top:1px solid #dbe3ef;margin-top:28px;padding-top:18px"><tbody><tr><td><p class="email-ink" style="font-size:13px;line-height:20px;color:#16213a;margin:0 0 4px;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">Terima kasih telah menggunakan layanan kami.</p><p class="email-muted" style="font-size:11px;line-height:24px;color:#50617f;margin:10px 0 0;margin-top:10px;margin-right:0;margin-bottom:0;margin-left:0">Dikirim melalui PayLanggan untuk Kelana Workspace.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
`;

