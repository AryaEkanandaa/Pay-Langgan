{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:pdf": "node scripts/report-pdf-smoke.cjs",
    "email:dev": "email dev --dir src/emails --port 3001",
    "email:test": "vitest run src/emails/__tests__",
    "email:build": "esbuild scripts/email-render-server.ts --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=dist/email-render-server.mjs",
    "email:serve": "npm run email:build && node dist/email-render-server.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "lucide-react": "^1.25.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-email": "^6.11.2",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "xendit-components-web": "^0.0.35"
  },
  "devDependencies": {
    "@react-email/ui": "^6.11.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.4"
  }
}
