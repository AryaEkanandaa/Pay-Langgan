APP_NAME=PAY-LANGGAN.COM
APP_ENV=development
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pay_langgan
DB_SSLMODE=disable

BILLING_INTERVAL=1m
BILLING_BATCH_TIMEOUT=30s
BILLING_BATCH_LIMIT=100

# Xendit. Keep mock enabled until test credentials and HTTPS return URLs are ready.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_MOCK=true

JWT_SECRET=change_this_secret_to_a_random_string
JWT_EXPIRES_IN=24h

MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_MOCK=true
