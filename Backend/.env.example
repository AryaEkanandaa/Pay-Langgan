APP_NAME=PAY-LANGGAN.COM
APP_ENV=development
APP_PORT=8080
# Checkout URL and allowed Xendit Components origin (include the frontend port).
# For real Xendit Components, use the active HTTPS frontend origin here and in
# XENDIT_RETURN_BASE_URL. Platform billing validates that both origins match.
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8080

# Generate a dedicated key with: openssl rand -base64 32
# Keep this key outside source control; losing it makes saved gateway credentials unreadable.
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pay_langgan
DB_SSLMODE=disable

BILLING_INTERVAL=1m
BILLING_BATCH_TIMEOUT=30s
BILLING_BATCH_LIMIT=100

# Xendit Components. Mock SDK keys are placeholders, not usable with the real SDK.
# Use mock=false with development credentials for Xendit sandbox testing.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_MOCK=true
XENDIT_RETURN_BASE_URL=https://paylanggan.example
CHECKOUT_TTL=24h
# New automatic debits require this switch AND explicit per-subscription consent.
AUTOPAY_ENABLED=false

JWT_SECRET=change_this_secret_to_a_random_string
JWT_EXPIRES_IN=24h

MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_MOCK=true

# Email invoice: disabled | preview | smtp. Preview tidak mengirim email.
EMAIL_DELIVERY_MODE=preview
EMAIL_RENDERER_URL=http://127.0.0.1:3101
EMAIL_PREVIEW_DIR=../.tmp/email-preview
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# false = STARTTLS (587); true = implicit TLS (465)
SMTP_IMPLICIT_TLS=false

# Stable public base for invoice logos; no trailing slash, no temporary tunnel.
# Example: https://assets.YOUR_DOMAIN/public-assets/invoice-logos
PUBLIC_ASSET_URL=
INVOICE_ASSET_DIR=./storage/invoice-logos
